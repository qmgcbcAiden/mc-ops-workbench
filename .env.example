# Minecraft 服务器运维仪表盘环境变量示例
#
# 将本文件复制为 `.env`，然后按你的本机环境修改配置值。
# 不要提交 `.env`：其中可能包含 API Key 和 RCON 密码。
#
# 路径值既可以写相对项目根目录的路径，也可以写绝对路径。
# 布尔值会先转为小写，只有值等于 "true" 时才会被读取为开启；
# 如需关闭，请使用 "false"。


# -----------------------------------------------------------------------------
# 应用运行环境
# -----------------------------------------------------------------------------

# 当前运行环境标识。
# 用于区分环境相关行为和诊断信息。MVP 默认值为 "dev"；
# 常见取值包括 dev、test、prod。
APP_ENV=dev

# SQLite 数据库路径，用于保存审计轨迹、聊天历史、指标、快照和运行记录。
# 相对路径会基于项目根目录解析。
APP_DB_PATH=data/app.db


# -----------------------------------------------------------------------------
# Flet 界面
# -----------------------------------------------------------------------------

# Flet 启动模式。
# - desktop：以桌面应用窗口打开仪表盘。
# - 其他值：以网页浏览器方式运行仪表盘。
FLET_RUN_VIEW=desktop

# 仅当 FLET_RUN_VIEW 不是 "desktop" 时使用的监听地址。
# 127.0.0.1 表示 Web 界面仅本机可访问。
# 0.0.0.0 表示允许局域网访问，请谨慎使用。
FLET_SERVER_HOST=127.0.0.1

# 仅当 FLET_RUN_VIEW 不是 "desktop" 时使用的监听端口。
FLET_SERVER_PORT=8550


# -----------------------------------------------------------------------------
# DeepSeek / Qwen / OpenAI 兼容大模型 API
# -----------------------------------------------------------------------------

# 默认主聊天模型。运行时也可以在聊天输入框中切换；
# UI 中的选择会保存到 SQLite，重启后继续使用。
AI_DEFAULT_MODEL=deepseek-v4-flash

# DeepSeek API Key。
# 留空会使 DeepSeek 模型不可用。不要提交真实 Key。
DEEPSEEK_API_KEY=replace_me

# DeepSeek OpenAI 兼容接口基础 URL。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen API Key。
# 仅选择 Qwen 模型时需要。不要提交真实 Key。
QWEN_API_KEY=replace_me

# Qwen OpenAI 兼容接口的基础 URL。
# 阿里云 DashScope 兼容模式可使用：
# https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Qwen provider 的兼容默认模型名。UI 模型选择会优先使用所选模型 id。
QWEN_MODEL=qwen3.5-plus

# 可选的日志分析专用模型。
# 留空时复用 QWEN_MODEL。
QWEN_LOG_MODEL=

# 大模型请求超时时间，单位为秒。
# 网络较慢或模型响应较慢时可以适当调大。
QWEN_TIMEOUT_SECONDS=60

# 请求模型输出的最大 token 数。
# 数值越高，回复可更长，但成本可能更高，响应也可能更慢。
# 诊断类回复通常包含表格，过低会触发 finish_reason=length 截断。
QWEN_MAX_TOKENS=2400

# 模型回复的采样温度。
# 数值越低越稳定、越确定；数值越高回复越发散。
QWEN_TEMPERATURE=0.2

# 发送给 AI 助手的聊天上下文最大总字符数。
# 这是上下文保护限制，避免把过大的提示词直接传给模型；
# 较旧的对话会优先被摘要压缩。
AI_CONTEXT_MAX_CHARS=24000

# 在使用摘要前，原样保留的最近消息数量。
AI_RECENT_MESSAGES_LIMIT=16

# 触发对话摘要生成的消息数量阈值。
AI_SUMMARY_TRIGGER_MESSAGES=24

# 生成对话摘要时的目标字符数。
AI_SUMMARY_TARGET_CHARS=3000

# AI 日志压缩/摘要前允许读取的原始日志最大字符数。
# 不应把完整日志文件直接传给模型，请保持该值有界。
AI_LOG_RAW_MAX_CHARS=60000

# 发送给模型的压缩后日志上下文最大字符数。
AI_LOG_COMPRESSED_MAX_CHARS=8000

# 当接口支持时，是否在界面中启用 AI 流式回复。
AI_STREAM_ENABLED=true


# -----------------------------------------------------------------------------
# Minecraft 服务器进程
# -----------------------------------------------------------------------------

# Minecraft 服务器目录。
# 应用启动服务器时会在此目录下创建必要的运行文件。
MC_SERVER_DIR=mc_server

# 服务端 jar 文件。相对路径会基于 MC_SERVER_DIR 解析。
# 示例：server.jar -> mc_server/server.jar
MC_SERVER_JAR=server.jar

# 用于启动服务器的 Java 可执行文件。
# 使用 "java" 表示依赖 PATH；也可以写某个 Java 二进制文件的绝对路径。
MC_JAVA_PATH=java

# 传给 JVM 的初始堆内存大小，即 -Xms。
MC_JAVA_XMS=1G

# 传给 JVM 的最大堆内存大小，即 -Xmx。
MC_JAVA_XMX=2G

# 追加在 "-jar <server.jar>" 后面的额外启动参数。
# 服务器运行时推荐使用 "nogui"。
MC_EXTRA_ARGS=nogui

# 仪表盘读取的服务器日志路径。
# 相对路径会基于项目根目录解析。
MC_LOG_PATH=mc_server/logs/latest.log

# 界面中展示的命令模式标签。
# 当前命令执行会通过托管服务器进程的 stdin 发送；
# 配置 RCON 后，RCON 仍会用于玩家列表校准。
MC_COMMAND_MODE=stdin

# 启动超时时间，单位为秒。
# 超时前应用会尝试将已启动进程标记为 running，或报告启动失败。
MC_START_TIMEOUT_SECONDS=30

# 优雅关闭超时时间，单位为秒。
# 发送 "stop" 后，超过该时间仍未退出时，应用会终止进程树。
MC_STOP_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# Java 环境检测与便携安装
# -----------------------------------------------------------------------------

# 是否允许聊天中的 Java 修复流程自动下载并安装项目内便携 Java。
JAVA_AUTO_INSTALL_ENABLED=true

# 便携 Java 安装目录。相对路径会基于项目根目录解析。
JAVA_AUTO_INSTALL_DIR=data/java

# Java 发行版。当前自动下载实现使用 Temurin / Adoptium。
JAVA_DISTRIBUTION=temurin

# 便携安装包类型。jre 会优先下载 JRE，找不到时兜底 JDK。
JAVA_PACKAGE_TYPE=jre


# -----------------------------------------------------------------------------
# Minecraft RCON
# -----------------------------------------------------------------------------

# RCON 主机地址，用于玩家列表校准，以及自动写入 server.properties 的 RCON 配置。
# 如果服务器由本应用启动，通常保持本机地址即可。
MC_RCON_HOST=127.0.0.1

# RCON 端口。应用会将该值写入 server.properties，并用于 RCON 查询。
MC_RCON_PORT=25575

# RCON 密码。应用启动时会将该值写入 server.properties，并用于 RCON 查询。
# 当前应用启动流程需要该值。不要提交真实密码。
MC_RCON_PASSWORD=replace_me


# -----------------------------------------------------------------------------
# Minecraft 文件浏览器与编辑器
# -----------------------------------------------------------------------------

# 仪表盘预览文本文件时允许读取的最大字节数。
MC_FILE_PREVIEW_MAX_BYTES=1048576

# 文件浏览器展示目录树时允许的最大目录深度。
MC_FILE_TREE_MAX_DEPTH=32

# 保存可编辑文本文件时允许的最大字节数。
MC_EDITABLE_FILE_MAX_BYTES=1048576

# 保存文件时是否创建带时间戳的备份。
# 如果配置版本管理已经为该文件捕获了可用基线快照，则不会再额外备份。
MC_CONFIG_BACKUP_ON_SAVE=true


# -----------------------------------------------------------------------------
# Mod / 插件冲突诊断与外部知识增强
# -----------------------------------------------------------------------------

# 是否允许组件诊断在被明确要求刷新在线元数据时访问外部结构化 API。
# 普通本地扫描不会主动联网。
ADDON_KNOWLEDGE_ONLINE_ENABLED=true

# 是否启用 Modrinth hash 查询。Modrinth 查询不需要 API Key。
MODRINTH_ENABLED=true

# CurseForge REST API Key。留空时跳过 CurseForge fingerprint 查询。
# 不要提交真实 Key。
CURSEFORGE_API_KEY=

# 外部元数据缓存有效期，单位为小时。
ADDON_KNOWLEDGE_CACHE_TTL_HOURS=72

# 单个 jar 扫描大小上限，超过后跳过内容解析，只记录低置信度元信息。
ADDON_SCAN_MAX_JAR_BYTES=104857600


# -----------------------------------------------------------------------------
# 配置版本管理与 AI 辅助配置修改
# -----------------------------------------------------------------------------

# 是否为可编辑的 Minecraft 配置文件启用本地 Git 版本历史。
# 仓库位于 CONFIG_VERSION_REPO_DIR，用于保存脱敏后的配置快照。
CONFIG_VERSIONING_ENABLED=true

# 配置快照本地仓库路径。
# 相对路径会基于项目根目录解析。
CONFIG_VERSION_REPO_DIR=data/config_versions/default/repo

# 允许自动批准的最高配置修改风险等级。
# 推荐值为 NONE。其他可用值取决于 src/service/config_edit_service.py 中的
# 风险等级排序，例如 LOW 或 MEDIUM。
CONFIG_AUTO_APPROVE_MAX_RISK=NONE

# 配置修改提案和快照中记录的脱敏规则版本。
# 除非明确迁移脱敏策略，否则保持 "v1"。
CONFIG_REDACTION_VERSION=v1

# 是否启用自主配置修改循环。默认关闭。
AUTONOMOUS_CONFIG_LOOP_ENABLED=false

# 自主循环最大轮数、LLM 调用次数和工具调用次数。
AUTONOMOUS_CONFIG_LOOP_MAX_ROUNDS=3
AUTONOMOUS_CONFIG_LOOP_MAX_LLM_CALLS=8
AUTONOMOUS_CONFIG_LOOP_MAX_TOOL_CALLS=20

# 自主循环允许自动应用的最高风险等级。
# 该值只影响自主循环，不影响 CONFIG_AUTO_APPROVE_MAX_RISK。
AUTONOMOUS_CONFIG_LOOP_AUTO_APPLY_MAX_RISK=LOW

# 首版默认只做文件级验证。开启运行时验证前需补齐相应测试。
AUTONOMOUS_CONFIG_LOOP_VERIFY_RUNTIME=false
